{
  "name": "uplink",
  "type": "module",
  "version": "0.1.4",
  "private": true,
  "description": "Uplink",
  "license": "MIT",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules pantry.lock && bun install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "release:check": "bun .github/scripts/check-release-version.ts",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:calendar": "./buddy release --bump calendar",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:framework": "bun x --bun tsc --noEmit -p storage/framework/tsconfig.framework.json --pretty false && bun x --bun tsc --noEmit -p storage/framework/tsconfig.defaults.json --pretty false",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:bench": "bun x --bun tsc --noEmit -p bench/tsconfig.json --pretty false",
    "test:bench": "bun test ./bench/memory/*.test.ts ./bench/routing/*.test.ts ./bench/startup/*.test.ts",
    "typecheck:views": "bun x --bun stx typecheck --lib storage/framework/types/request-context.d.ts 'resources/**/*.stx' 'storage/framework/defaults/views/**/*.stx' 'storage/framework/defaults/resources/**/*.stx' 'storage/framework/core/error-handling/src/views/**/*.stx' 'storage/framework/defaults/stores/*.stx' 'storage/framework/libs/examples/**/*.stx'",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "types:fix": "./buddy types:fix",
    "bench:memory": "bun bench/memory/run.ts",
    "bench:routing": "bun bench/routing/run.ts",
    "bench:startup": "bun bench/startup/run.ts",
    "bench:database-runtime": "bun bench/startup/database-run.ts",
    "bench:database-runtime:report": "bun bench/startup/database-report.ts",
    "bench:startup:peers": "bun bench/startup/peer-run.ts",
    "bench:startup:peer-report": "bun bench/startup/peer-report.ts",
    "bench:startup:ready": "bun bench/startup/listen-run.ts",
    "bench:startup:report": "bun bench/startup/report.ts",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "docs:buddy": "./buddy docs:buddy",
    "docs:buddy:check": "./buddy docs:buddy:check",
    "docs:capabilities": "./buddy docs:capabilities",
    "docs:capabilities:check": "./buddy docs:capabilities:check",
    "docs:desktop-matrix": "./buddy docs:desktop-matrix",
    "docs:desktop-matrix:check": "./buddy docs:desktop-matrix:check",
    "docs:artifacts": "./buddy docs:artifacts",
    "declarations:check": "bun .github/scripts/check-declarations-fresh.ts",
    "docs:artifacts:check": "./buddy docs:artifacts:check",
    "docs:links": "./buddy docs:links",
    "docs:links:check": "./buddy docs:links:check",
    "docs:snippets": "./buddy docs:snippets",
    "docs:snippets:check": "./buddy docs:snippets:check",
    "deps:lockfile:check": "bun .github/scripts/check-lockfile-version.ts",
    "bud": "./buddy",
    "stx": "./buddy",
    "docs:agent-counts": "./buddy docs:agent-counts",
    "docs:agent-counts:check": "./buddy docs:agent-counts:check"
  },
  "dependencies": {
    "@stacksjs/actions": "^0.75.30",
    "@stacksjs/env": "^0.75.30",
    "@stacksjs/path": "^0.75.30",
    "bunfig": "^0.15.19",
    "pickier": "^0.1.65",
    "stacks": "^0.75.30",
    "stripe": "22.6.2"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "better-dx": "^0.2.24"
  }
}
