<script server>
// The not-found page. With `ui.defaultViews: false` the framework's own
// errors/404 view is not served, so the app answers with this instead.
const title = 'Not found - Uplink'
// The body said Not found and the status line said 200, so a crawler indexed
// every wrong URL as a real page and a client treated the miss as a hit. The
// dashboard already does this; this page did not.
notFound()
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <meta name="color-scheme" content="light dark">
    <!-- The same pair site-head.stx sets, because a page with its own head is
         still the same site to the browser chrome around it. -->
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)">
    <title>{{ title }}</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <!-- Self-hosted, like the shared head. This page has its own. -->
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/geist-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url("/fonts/geist-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Geist Mono";
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url("/fonts/geist-mono-latin-ext.woff2") format("woff2");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: "Geist Mono";
        font-style: normal;
        font-weight: 400 600;
        font-display: swap;
        src: url("/fonts/geist-mono-latin.woff2") format("woff2");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      :root { --paper: #fafaf9; --ink: #18181b; --muted: #52525b; --accent: #f59e0b; --accent-ink: #b45309; }
      @media (prefers-color-scheme: dark) { :root { --paper: #0c0c0e; --ink: #f4f4f5; --muted: #a1a1aa; --accent-ink: #fbbf24; } }
      html body.uplink { background: var(--paper); color: var(--ink); font-family: 'Geist', ui-sans-serif, system-ui, sans-serif; }
      .uplink .u-muted { color: var(--muted); }
      .uplink .u-accent { color: var(--accent-ink); }
      .uplink .u-btn { display: inline-flex; align-items: center; gap: .5rem; white-space: nowrap; border-radius: 9999px; padding: .75rem 1.25rem; font-weight: 600; background: var(--accent); color: #18181b; transition: transform .2s cubic-bezier(.16, 1, .3, 1); }
      .uplink .u-btn:active { transform: translateY(1px) scale(.98); }
      .uplink a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    </style>
  </head>
  <body class="antialiased uplink">
    <main class="flex flex-col justify-center mx-auto px-4 sm:px-6 max-w-xl min-h-[100dvh]">
      <span class="size-7 i-hugeicons-satellite-02 u-accent" aria-hidden="true"></span>
      <h1 class="mt-6 font-semibold text-4xl tracking-tight">No signal here.</h1>
      <p class="mt-4 text-lg u-muted">There is no page at this address.</p>
      <div class="mt-8">
        <a href="/" class="u-btn">Back to Uplink</a>
      </div>
    </main>
  </body>
</html>
