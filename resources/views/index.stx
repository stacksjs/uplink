<script server>
/**
 * uplink.stacksjs.com - the public page.
 *
 * Design read: a product landing page for technical Mac users, calm
 * dark-tech language, Geist + one sodium-amber accent (the colour of the
 * city lights in the hero photo). Dials 7 / 5 / 4.
 *
 * Everything shown is real: the two exchanges are genuine Uplink replies
 * from 2026-09-27 (passed through the same formatter a text goes through),
 * the commands are the ones the app ships, the photos are NASA's.
 * No client script: motion is CSS only, and every animation has a
 * reduced-motion fallback.
 */
const path = '/'
const title = 'Uplink - text your Mac, get Claude, even over satellite'
const description = 'Uplink turns an iMessage, even one sent over satellite with no data, into an agent run on your Mac.'

const exchanges = [
  {
    ask: 'When will the padres play on Thursday? And what\'s the nfl scores today?',
    reply: 'Padres: no regular-season game this Thursday - they clinched a playoff spot and are in the NL Wild Card Series vs the Cubs; Game 3 (if needed) is set for Thursday Oct 1, time TBA.\n\nNFL today (Sun 9/27) early games: Steelers 30, Bengals 27; Lions 31, Jets 24; Jaguars 35, Patriots 6; Bills 24, Chargers 16; Browns 21, Panthers 18. More games still to kick off later today.',
    note: 'Two web searches, 14 seconds.',
  },
  {
    ask: 'What changed in ~/Code/stacks today? Three short lines.',
    reply: 'Today: fixed CMS article images (Medium-style publish + stx script left alone), tightened typecheck so @stacksjs subpaths resolve to source not stale dist, fixed noUncheckedIndexedAccess in image reader, and cut releases v0.75.7 and v0.75.8.',
    note: 'Ran git log inside the repo, 14 seconds.',
  },
]

const steps = [
  { icon: 'i-hugeicons-message-01', verb: 'Text', body: 'Message yourself from your iPhone. iMessage over satellite needs no cell or Wi-Fi signal.' },
  { icon: 'i-hugeicons-inbox', verb: 'Read', body: 'Uplink watches the Messages database on your Mac and picks up texts from handles you allow.' },
  { icon: 'i-hugeicons-terminal', verb: 'Run', body: 'Claude Code or Codex runs headless on the plan you already have, inside the repository your text names.' },
  { icon: 'i-hugeicons-sent', verb: 'Reply', body: 'The answer comes back as plain text, split into at most three messages.' },
]

const words = [
  { word: 'status', does: 'what it is working on' },
  { word: 'stop', does: 'cancel the task and the queue' },
  { word: 'new', does: 'start a fresh conversation' },
  { word: 'more', does: 'the rest of a long reply' },
  { word: 'ping', does: 'check it is alive' },
  { word: 'claude / codex', does: 'switch that thread to that agent' },
]

import release from '../data/release.json'
import { formatCents, PLANS, yearlySavingPercent } from '../../app/Billing/plans'

const downloadUrl = release.url
const downloadMeta = `Version ${release.version}, macOS ${release.minimumMacOS} or later, ${Math.round(release.bytes / 1_000_000)} MB`

const install = [
  { verb: 'Install', body: 'Open the download and drag Uplink to Applications. It is signed and notarized by Apple, so it opens like any other app.' },
  { verb: 'Say yes three times', body: 'Uplink sets itself up. It opens the one switch in System Settings it needs, signs in to the agent you chose, and asks once to use Messages. It finds your numbers by itself.' },
  { verb: 'Text it', body: 'Send yourself "ping" from your iPhone. The answer starts with a satellite.' },
]

const pricing = PLANS.map(plan => ({ ...plan, price: formatCents(plan.priceCents) }))
const yearlySaving = yearlySavingPercent()


const faqs = [
  {
    q: 'Does texting yourself work over satellite?',
    a: 'It depends on how your iPhone routes a message to your own number, so try it once before you rely on it. If it does not arrive, sign the Mac into a second Apple ID and text that instead.',
  },
  {
    q: 'Why does it need Full Disk Access?',
    a: 'Messages keeps your texts in a database macOS protects. Uplink reads it to notice texts from the handles you allow, and ignores every other conversation.',
  },
  {
    q: 'Do I need an API key?',
    a: 'No. Uplink runs the CLI you already pay for: Claude Code on a Claude plan, which signs in through your browser and keeps its token in your Keychain, or Codex on a ChatGPT plan, which keeps its own credentials and leaves Uplink holding nothing.',
  },
  {
    q: 'What can it do on my Mac?',
    a: 'Anything the agent can: search the web, read and edit files, run your tests. That is why only one-to-one chats with handles you allow can reach it.',
  },
  {
    q: 'What does it cost?',
    a: '$1.99 a month, $19.99 a year, or $29.99 once. That is for Uplink itself; the answers run on the plan you already have, Claude or ChatGPT, and nothing is charged per text.',
  },
  {
    q: 'Can it answer with ChatGPT instead?',
    a: 'Yes. Choose Codex in the menubar and Uplink answers with your ChatGPT plan instead of Claude. Everything else works the same way.',
  },
  {
    q: 'What happens while my Mac sleeps?',
    a: 'Nothing, so Uplink keeps it from idle-sleeping while it runs. A laptop with its lid closed still sleeps unless it is on power with a display attached.',
  },
]
</script>

@nolayout
<!DOCTYPE html>
<html lang="en">
  <head>
    @include('site-head')
    <link rel="preload" as="image" href="/images/california-night-1920.jpg" imagesrcset="/images/california-night-960.jpg 960w, /images/california-night-1920.jpg 1920w" imagesizes="(min-width: 1024px) 50vw, 100vw">
  </head>
  <body class="antialiased uplink">
    @include('site-nav')

    <main>
      <section class="grid gap-10 items-center lg:gap-14 lg:grid-cols-[1.05fr_1fr] mx-auto pb-16 pt-12 px-4 sm:px-6 lg:pb-24 lg:pt-20 max-w-6xl">
        <div>
          <h1 class="font-semibold leading-[1.05] text-4xl tracking-tighter md:text-5xl xl:text-6xl u-rise" style="--i: 0">
            Off the grid, still one text from Claude.
          </h1>
          <p class="mt-6 max-w-[34rem] leading-relaxed text-lg u-muted u-rise" style="--i: 1">
            Uplink turns an iMessage, even one sent over satellite with no data, into an agent run on your Mac, and texts the answer back.
          </p>
          <div class="flex flex-wrap gap-3 mt-8 u-rise" style="--i: 2">
            <a href="{{ downloadUrl }}" class="u-btn u-btn-primary">
              <span class="size-4 i-hugeicons-apple" aria-hidden="true"></span>
              Download for Mac
            </a>
            <a href="/pricing" class="u-btn u-btn-ghost">See pricing</a>
          </div>
          <p class="mt-6 text-sm u-mono u-muted u-rise" style="--i: 3">From $1.99 a month. Signed and notarized. macOS 13+.</p>
        </div>
        <figure class="overflow-hidden rounded-2xl u-rise" style="--i: 1">
          <img
            src="/images/california-night-1920.jpg"
            srcset="/images/california-night-960.jpg 960w, /images/california-night-1920.jpg 1920w"
            sizes="(min-width: 1024px) 50vw, 100vw"
            width="1920"
            height="1277"
            alt="The California coast at night from the International Space Station, city lights glowing orange under a thin band of atmosphere"
            class="block h-auto w-full"
            fetchpriority="high"
          >
        </figure>
      </section>

      <section class="border-t u-line" aria-labelledby="real-texts">
        <div class="mx-auto px-4 py-20 sm:px-6 lg:py-28 max-w-3xl">
          <h2 id="real-texts" class="font-semibold text-3xl tracking-tight md:text-4xl">Two real texts, answered.</h2>
          <p class="mt-4 max-w-[60ch] u-muted">Replies from September 27, 2026, exactly as Uplink sends them: plain text, marked with a satellite.</p>

          <div class="mt-12 space-y-14">
            @foreach(exchanges as exchange)
              <article class="grid gap-4">
                <div class="justify-self-end max-w-[85%] u-reveal">
                  <p class="px-5 py-3 rounded-2xl" style="background: var(--accent); color: #18181b">{{ exchange.ask }}</p>
                </div>
                <div class="max-w-[92%] u-reveal-late">
                  <p class="px-5 py-4 whitespace-pre-line border rounded-2xl u-line u-raised">🛰 {{ exchange.reply }}</p>
                  <p class="mt-2 pl-1 text-sm u-mono u-muted">{{ exchange.note }}</p>
                </div>
              </article>
            @endforeach
          </div>
        </div>
      </section>

      <section id="how" class="border-t scroll-mt-16 u-line" aria-labelledby="how-title">
        <div class="grid gap-12 lg:gap-20 lg:grid-cols-[0.9fr_1.1fr] mx-auto px-4 py-20 sm:px-6 lg:py-28 max-w-6xl">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="text-xs tracking-[0.18em] uppercase u-accent u-mono">How it works</p>
            <h2 id="how-title" class="mt-3 font-semibold text-3xl tracking-tight md:text-4xl">From a text to an agent session, and back.</h2>
            <p class="mt-4 max-w-[46ch] u-muted">No server in between. Your Mac reads the message, does the work and answers through Messages.</p>
          </div>
          <ol class="grid gap-10">
            @foreach(steps as step)
              <li class="grid gap-4 grid-cols-[auto_1fr] u-reveal">
                <span class="grid place-items-center size-11 rounded-full u-wash" aria-hidden="true">
                  <span class="size-5 u-accent {{ step.icon }}"></span>
                </span>
                <div>
                  <h3 class="font-semibold text-xl">{{ step.verb }}</h3>
                  <p class="mt-1 max-w-[52ch] leading-relaxed u-muted">{{ step.body }}</p>
                </div>
              </li>
            @endforeach
          </ol>
        </div>
      </section>

      <section class="border-t u-line" aria-labelledby="built-for">
        <div class="mx-auto px-4 py-20 sm:px-6 lg:py-28 max-w-6xl">
          <h2 id="built-for" class="max-w-[22ch] font-semibold text-3xl tracking-tight md:text-4xl">Built for a thin link and a real machine.</h2>

          <div class="grid gap-4 lg:grid-cols-3 lg:grid-rows-[auto_auto] mt-12">
            <article class="flex overflow-hidden relative flex-col justify-end lg:col-span-2 lg:row-span-2 min-h-[22rem] rounded-2xl u-reveal">
              <img
                src="/images/milky-way-airglow-1920.jpg"
                srcset="/images/milky-way-airglow-960.jpg 960w, /images/milky-way-airglow-1920.jpg 1920w"
                sizes="(min-width: 1024px) 66vw, 100vw"
                width="1920"
                height="1277"
                alt="The Milky Way above a band of orange airglow, photographed from the International Space Station"
                loading="lazy"
                class="absolute inset-0 object-cover h-full w-full"
              >
              <div class="relative p-6 sm:p-8" style="background: linear-gradient(to top, rgb(9 9 11 / .92), rgb(9 9 11 / .55) 70%, transparent); color: #f4f4f5">
                <h3 class="font-semibold text-2xl">Short answers, few texts.</h3>
                <p class="mt-2 max-w-[48ch]" style="color: #d4d4d8">Plain text, no markdown. A long reply is split into three texts, and the rest waits until you send more.</p>
              </div>
            </article>

            <article class="p-6 border rounded-2xl u-line u-raised u-reveal">
              <span class="size-6 i-hugeicons-folder-code u-accent" aria-hidden="true"></span>
              <h3 class="mt-4 font-semibold text-xl">Works inside your repos</h3>
              <p class="mt-2 leading-relaxed u-muted">Name a path and the run starts there, with that repository's agent instructions, hooks and settings, CLAUDE.md or AGENTS.md. Follow-ups continue the session.</p>
            </article>

            <article class="p-6 rounded-2xl u-reveal u-wash">
              <h3 class="font-semibold text-xl">Five words it always answers</h3>
              <dl class="grid gap-2 mt-4 text-sm">
                @foreach(words as item)
                  <div class="grid gap-3 grid-cols-[4rem_1fr]">
                    <dt class="font-medium u-accent u-mono">{{ item.word }}</dt>
                    <dd class="u-muted">{{ item.does }}</dd>
                  </div>
                @endforeach
              </dl>
            </article>

            <article class="flex flex-col gap-4 sm:flex-row sm:items-center lg:col-span-3 p-6 border rounded-2xl u-line u-raised u-reveal">
              <span class="grid place-items-center shrink-0 size-11 rounded-full u-wash" aria-hidden="true">
                <span class="size-5 i-hugeicons-lock-key u-accent"></span>
              </span>
              <div>
                <h3 class="font-semibold text-xl">Nobody else can use it</h3>
                <p class="mt-1 leading-relaxed u-muted">Only one-to-one chats with handles you allow. Group chats are ignored, and only Uplink.app gets Full Disk Access, not your terminal.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="download" class="border-t scroll-mt-16 u-line" aria-labelledby="download-title">
        <div class="grid gap-12 items-center lg:gap-16 lg:grid-cols-[1.1fr_0.9fr] mx-auto px-4 py-20 sm:px-6 lg:py-28 max-w-6xl">
          <div>
            <h2 id="download-title" class="font-semibold text-3xl tracking-tight md:text-4xl">Download Uplink for Mac.</h2>
            <p class="mt-4 max-w-[52ch] u-muted">A menubar app. You need Claude Code on a Claude plan, or Codex on a ChatGPT plan; Uplink takes care of the rest.</p>
            <div class="flex flex-wrap gap-x-5 gap-y-3 items-center mt-8">
              <a href="{{ downloadUrl }}" class="u-btn u-btn-primary">
                <span class="size-4 i-hugeicons-apple" aria-hidden="true"></span>
                Download for Mac
              </a>
              <p class="text-sm u-mono u-muted">{{ downloadMeta }}</p>
            </div>

            <ol class="grid gap-7 mt-12">
              @foreach(install as step)
                <li class="u-reveal">
                  <h3 class="font-semibold text-lg">{{ step.verb }}</h3>
                  <p class="mt-1 max-w-[52ch] leading-relaxed u-muted">{{ step.body }}</p>
                </li>
              @endforeach
            </ol>

            <p class="mt-10 text-sm u-muted">
              Rather build it yourself? <a href="https://github.com/stacksjs/uplink#build-from-source" class="underline underline-offset-4 hover:opacity-80">Build it from source</a>.
            </p>
          </div>
          <figure class="justify-self-center max-w-[386px] w-full u-reveal">
            <img
              src="/images/menubar-setup.png"
              width="772"
              height="934"
              alt="Uplink's menubar popover on first launch: four setup steps, starting with letting Uplink read your texts"
              loading="lazy"
              class="block h-auto w-full"
            >
          </figure>
        </div>
      </section>

      <section id="pricing" class="border-t scroll-mt-16 u-line" aria-labelledby="pricing-title">
        <div class="mx-auto px-4 py-20 sm:px-6 lg:py-28 max-w-6xl">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs tracking-[0.18em] uppercase u-accent u-mono">Pricing</p>
              <h2 id="pricing-title" class="mt-3 font-semibold text-3xl tracking-tight md:text-4xl">The whole app, however you like to pay.</h2>
            </div>
            <a href="/pricing" class="text-sm underline underline-offset-4 hover:opacity-80 u-muted">Compare plans</a>
          </div>
          <div class="grid gap-4 mt-10 sm:grid-cols-3">
            @foreach(pricing as plan)
              <a href="/checkout/{{ plan.id }}" class="group flex flex-col p-6 border rounded-2xl u-line u-raised u-reveal">
                <span class="text-sm font-medium u-muted">{{ plan.name }}</span>
                <span class="mt-3 flex gap-2 items-baseline">
                  <span class="font-semibold text-4xl tracking-tight u-num">{{ plan.price }}</span>
                  <span class="u-muted">{{ plan.cadence }}</span>
                </span>
                <span class="mt-2 text-sm u-muted">{{ plan.blurb }}</span>
                <span class="mt-6 inline-flex gap-1 items-center text-sm font-semibold u-accent">
                  Choose {{ plan.name }}
                  <span class="size-4 i-hugeicons-arrow-right-01 transition-transform group-hover:translate-x-0.5" aria-hidden="true"></span>
                </span>
              </a>
            @endforeach
          </div>
          <p class="mt-6 text-sm u-muted">Yearly saves {{ yearlySaving }}% over paying monthly. Checkout is handled by Stripe.</p>
        </div>
      </section>

      <section id="questions" class="border-t scroll-mt-16 u-line" aria-labelledby="questions-title">
        <div class="mx-auto px-4 py-20 sm:px-6 lg:py-28 max-w-3xl">
          <h2 id="questions-title" class="font-semibold text-3xl tracking-tight md:text-4xl">Questions</h2>
          <div class="mt-10 border-t u-line">
            @foreach(faqs as faq)
              <details class="border-b u-line">
                <summary class="flex gap-6 items-center justify-between py-5 font-medium text-lg">
                  {{ faq.q }}
                  <span class="shrink-0 size-5 i-hugeicons-plus-sign u-chevron u-muted" aria-hidden="true"></span>
                </summary>
                <p class="pb-6 max-w-[62ch] leading-relaxed u-muted">{{ faq.a }}</p>
              </details>
            @endforeach
          </div>
        </div>
      </section>
    </main>

    @include('site-footer')
  </body>
</html>
