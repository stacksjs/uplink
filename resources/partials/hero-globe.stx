<script server>
/**
 * The homepage's hero: a globe of dots, two satellites on one orbit, and the
 * path a text takes - iPhone with no signal, up to a satellite, across to the
 * next, down to the Mac - with packets moving along it, the reply coming back
 * the other way.
 *
 * Drawn here, not shipped as an image: the land is resources/data/land.json
 * (scripts/generate-globe.ts rasterizes Natural Earth, public domain), and the
 * page projects it with an orthographic projection when it renders. There is no
 * client script. The packets move with SVG's own animateMotion and everything
 * else is CSS; a reduced-motion preference hides the packets and stops the CSS,
 * which leaves the whole picture standing still and complete.
 */
import land from '../data/land.json'

const W = 640
const H = 600
const cx = 320
const cy = 360
const R = 214

// The globe is turned to put North America in front, the Atlantic on its right edge.
const lat0 = (24 * Math.PI) / 180
const lon0 = (-96 * Math.PI) / 180

function project(lon: number, lat: number) {
  const lam = (lon * Math.PI) / 180 - lon0
  const phi = (lat * Math.PI) / 180
  const cosc = Math.sin(lat0) * Math.sin(phi) + Math.cos(lat0) * Math.cos(phi) * Math.cos(lam)
  return {
    cosc,
    x: cx + R * Math.cos(phi) * Math.sin(lam),
    y: cy - R * (Math.cos(lat0) * Math.sin(phi) - Math.sin(lat0) * Math.cos(phi) * Math.cos(lam)),
  }
}

// Three paths rather than two thousand circles: a zero-length segment with a
// round cap is a dot, and the dots nearer the rim are dimmer and smaller.
const rim: string[] = []
const mid: string[] = []
const bright: string[] = []
for (const row of land.rows) {
  for (const lon of row.lons) {
    const p = project(lon, row.lat)
    if (p.cosc <= 0.04)
      continue
    const dot = `M${p.x.toFixed(1)} ${p.y.toFixed(1)}h0`
    ;(p.cosc < 0.3 ? rim : p.cosc < 0.6 ? mid : bright).push(dot)
  }
}
const rimDots = rim.join('')
const midDots = mid.join('')
const brightDots = bright.join('')

// Parallels and meridians, as the ellipses an orthographic view draws.
const graticule: string[] = []
for (const lat of [-60, -30, 0, 30, 60]) {
  const pts: string[] = []
  for (let lon = -180; lon <= 180; lon += 4) {
    const p = project(lon, lat)
    pts.push(p.cosc > 0 ? `${pts.length ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}` : '')
  }
  graticule.push(pts.filter(Boolean).join(''))
}
for (let lon = -180; lon < 180; lon += 30) {
  const pts: string[] = []
  let drawing = false
  for (let lat = -88; lat <= 88; lat += 4) {
    const p = project(lon, lat)
    if (p.cosc > 0) {
      pts.push(`${drawing ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
      drawing = true
    }
    else {
      drawing = false
    }
  }
  graticule.push(pts.join(''))
}
const graticulePath = graticule.join('')

// One orbit, tilted, around the globe. Its far side runs behind the planet.
const orbit = { cx: 320, cy: 334, rx: 296, ry: 112, tilt: -14 }
function onOrbit(degrees: number) {
  const t = (degrees * Math.PI) / 180
  const a = (orbit.tilt * Math.PI) / 180
  const x = orbit.rx * Math.cos(t)
  const y = orbit.ry * Math.sin(t)
  return { x: orbit.cx + x * Math.cos(a) - y * Math.sin(a), y: orbit.cy + x * Math.sin(a) + y * Math.cos(a) }
}
const sat1 = onOrbit(204)
const sat2 = onOrbit(326)
const orbitBack = `M${onOrbit(180).x.toFixed(1)} ${onOrbit(180).y.toFixed(1)}`
  + Array.from({ length: 31 }, (_, i) => { const p = onOrbit(180 + (i + 1) * 6); return `L${p.x.toFixed(1)} ${p.y.toFixed(1)}` }).join('')
const orbitFront = `M${onOrbit(0).x.toFixed(1)} ${onOrbit(0).y.toFixed(1)}`
  + Array.from({ length: 31 }, (_, i) => { const p = onOrbit((i + 1) * 6); return `L${p.x.toFixed(1)} ${p.y.toFixed(1)}` }).join('')

const phone = project(-111.9, 40.8) // Salt Lake City, a long way from a cell tower
const mac = project(-73.9, 40.7) // home

function arc(a: { x: number, y: number }, b: { x: number, y: number }, lift: number) {
  const mx = (a.x + b.x) / 2
  const my = Math.min(a.y, b.y) - lift
  return `M${a.x.toFixed(1)} ${a.y.toFixed(1)}Q${mx.toFixed(1)} ${my.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`
}

const hops = [
  { id: 'hop-up', d: arc(phone, sat1, 70) },
  { id: 'hop-across', d: arc(sat1, sat2, 46) },
  { id: 'hop-down', d: arc(sat2, mac, 64) },
]

// One 10 second loop: the text goes out in the first half, the reply comes
// back in the second. Each hop owns a slice of its half.
const CYCLE = 10
function windowOf(hop: number, back: boolean) {
  const slice = 0.5 / hops.length
  const start = (back ? 0.5 : 0) + (back ? hops.length - 1 - hop : hop) * slice
  return { start, end: start + slice * 0.86 }
}
function packets(back: boolean) {
  return hops.map((hop, i) => {
    const w = windowOf(i, back)
    const t = (n: number) => n.toFixed(4)
    return {
      id: hop.id,
      points: back ? '1;1;0;0' : '0;0;1;1',
      times: `0;${t(w.start)};${t(w.end)};1`,
      fade: `0;${t(w.start)};${t(w.start + 0.012)};${t(w.end - 0.012)};${t(w.end)};1`,
    }
  })
}
const outbound = packets(false)
const inbound = packets(true)

// A few fixed stars, placed by a seeded sequence so the page is the same on every render.
let seed = 7
const next = () => (seed = (seed * 16807) % 2147483647) / 2147483647
const stars = Array.from({ length: 46 }, () => {
  const x = next() * W
  const y = next() * H
  return { x: x.toFixed(0), y: y.toFixed(0), r: (0.5 + next() * 0.9).toFixed(1), d: (next() * 6).toFixed(1) }
}).filter(s => Math.hypot(Number(s.x) - cx, Number(s.y) - cy) > R + 8)
</script>

<figure class="overflow-hidden relative rounded-2xl globe u-rise" style="--i: 1">
  <svg viewBox="0 0 {{ W }} {{ H }}" role="img" aria-labelledby="globe-title globe-desc" class="block h-auto w-full" preserveAspectRatio="xMidYMid slice">
    <title id="globe-title">A text crossing the sky</title>
    <desc id="globe-desc">A globe made of dots. A message leaves an iPhone in the Utah desert, climbs to a satellite, crosses to a second satellite, and comes down at a Mac on the East Coast. The reply travels back the same way.</desc>

    <defs>
      <radialGradient id="globe-sky" cx="50%" cy="46%" r="68%">
        <stop offset="0" stop-color="#17140f" />
        <stop offset="1" stop-color="#07070a" />
      </radialGradient>
      <radialGradient id="globe-body" cx="38%" cy="32%" r="78%">
        <stop offset="0" stop-color="#1d1a14" />
        <stop offset="0.7" stop-color="#0d0c0a" />
        <stop offset="1" stop-color="#070709" />
      </radialGradient>
      <radialGradient id="globe-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0.9" stop-color="#f59e0b" stop-opacity="0.16" />
        <stop offset="1" stop-color="#f59e0b" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="globe-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#fbbf24" stop-opacity="0.9" />
        <stop offset="1" stop-color="#f59e0b" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="link-out" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fbbf24" />
        <stop offset="1" stop-color="#fde68a" />
      </linearGradient>
      @foreach(hops as hop)
        <path id="{{ hop.id }}" d="{{ hop.d }}" />
      @endforeach
    </defs>

    <rect width="{{ W }}" height="{{ H }}" fill="url(#globe-sky)" />

    <g fill="#f4f4f5" aria-hidden="true">
      @foreach(stars as star)
        <circle class="globe-star" cx="{{ star.x }}" cy="{{ star.y }}" r="{{ star.r }}" style="animation-delay: -{{ star.d }}s" />
      @endforeach
    </g>

    <path d="{{ orbitBack }}" fill="none" stroke="#f4f4f5" stroke-opacity="0.16" stroke-width="1" stroke-dasharray="2 5" />

    <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ R + 26 }}" fill="url(#globe-halo)" />
    <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ R }}" fill="url(#globe-body)" />
    <path d="{{ graticulePath }}" fill="none" stroke="#f4f4f5" stroke-opacity="0.07" stroke-width="0.6" />
    <g fill="none" stroke="#fbbf24" stroke-linecap="round">
      <path d="{{ rimDots }}" stroke-width="1.5" stroke-opacity="0.32" />
      <path d="{{ midDots }}" stroke-width="2.1" stroke-opacity="0.62" />
      <path d="{{ brightDots }}" stroke-width="2.7" stroke-opacity="0.95" />
    </g>
    <circle cx="{{ cx }}" cy="{{ cy }}" r="{{ R }}" fill="none" stroke="#fbbf24" stroke-opacity="0.35" stroke-width="1" />

    <path d="{{ orbitFront }}" fill="none" stroke="#f4f4f5" stroke-opacity="0.22" stroke-width="1" stroke-dasharray="2 5" />

    <g fill="none" stroke-linecap="round">
      @foreach(hops as hop)
        <use href="#{{ hop.id }}" stroke="#fbbf24" stroke-opacity="0.18" stroke-width="1.2" />
        <use href="#{{ hop.id }}" class="globe-flow" stroke="#fde68a" stroke-opacity="0.85" stroke-width="1.4" stroke-dasharray="3 9" />
      @endforeach
    </g>

    <g class="globe-sat" aria-hidden="true">
      <g transform="translate({{ sat1.x.toFixed(1) }} {{ sat1.y.toFixed(1) }}) rotate(-14) scale(1.35)">
        <rect x="-26" y="-4" width="17" height="8" rx="1" fill="#27272a" stroke="#fbbf24" stroke-opacity="0.7" stroke-width="0.8" />
        <rect x="9" y="-4" width="17" height="8" rx="1" fill="#27272a" stroke="#fbbf24" stroke-opacity="0.7" stroke-width="0.8" />
        <rect x="-7" y="-7" width="14" height="14" rx="3" fill="#e4e4e7" />
        <circle r="2.2" fill="#f59e0b" />
      </g>
      <g transform="translate({{ sat2.x.toFixed(1) }} {{ sat2.y.toFixed(1) }}) rotate(-14) scale(1.35)">
        <rect x="-26" y="-4" width="17" height="8" rx="1" fill="#27272a" stroke="#fbbf24" stroke-opacity="0.7" stroke-width="0.8" />
        <rect x="9" y="-4" width="17" height="8" rx="1" fill="#27272a" stroke="#fbbf24" stroke-opacity="0.7" stroke-width="0.8" />
        <rect x="-7" y="-7" width="14" height="14" rx="3" fill="#e4e4e7" />
        <circle r="2.2" fill="#f59e0b" />
      </g>
    </g>

    <g class="globe-packets" aria-hidden="true">
      @foreach(outbound as hop)
        <circle r="3.4" fill="#fef3c7" opacity="0">
          <animateMotion dur="{{ CYCLE }}s" repeatCount="indefinite" calcMode="linear" keyPoints="{{ hop.points }}" keyTimes="{{ hop.times }}"><mpath href="#{{ hop.id }}" /></animateMotion>
          <animate attributeName="opacity" dur="{{ CYCLE }}s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="{{ hop.fade }}" />
        </circle>
      @endforeach
      @foreach(inbound as hop)
        <g opacity="0">
          <rect x="-5.5" y="-3.6" width="11" height="7.2" rx="2.4" fill="#f59e0b" />
          <animateMotion dur="{{ CYCLE }}s" repeatCount="indefinite" calcMode="linear" keyPoints="{{ hop.points }}" keyTimes="{{ hop.times }}"><mpath href="#{{ hop.id }}" /></animateMotion>
          <animate attributeName="opacity" dur="{{ CYCLE }}s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="{{ hop.fade }}" />
        </g>
      @endforeach
    </g>

    <g aria-hidden="true">
      <circle cx="{{ phone.x.toFixed(1) }}" cy="{{ phone.y.toFixed(1) }}" r="26" fill="url(#globe-glow)" opacity="0.55" />
      <circle class="globe-ping" cx="{{ phone.x.toFixed(1) }}" cy="{{ phone.y.toFixed(1) }}" r="5" fill="none" stroke="#fbbf24" stroke-width="1.2" />
      <circle cx="{{ phone.x.toFixed(1) }}" cy="{{ phone.y.toFixed(1) }}" r="3.6" fill="#fffbeb" />
      <circle class="globe-ping globe-ping-late" cx="{{ mac.x.toFixed(1) }}" cy="{{ mac.y.toFixed(1) }}" r="5" fill="none" stroke="#fbbf24" stroke-width="1.2" />
      <circle cx="{{ mac.x.toFixed(1) }}" cy="{{ mac.y.toFixed(1) }}" r="26" fill="url(#globe-glow)" opacity="0.55" />
      <circle cx="{{ mac.x.toFixed(1) }}" cy="{{ mac.y.toFixed(1) }}" r="3.6" fill="#fffbeb" />
      <g font-family="'Geist Mono', ui-monospace, monospace" font-size="16" fill="#f4f4f5" stroke="#07070a" stroke-width="4" paint-order="stroke" stroke-linejoin="round">
        <text x="{{ (phone.x - 14).toFixed(1) }}" y="{{ (phone.y + 30).toFixed(1) }}" text-anchor="end">iPhone, no signal</text>
        <text x="{{ (mac.x + 12).toFixed(1) }}" y="{{ (mac.y + 30).toFixed(1) }}">your Mac</text>
      </g>
    </g>
  </svg>

  <figcaption class="flex absolute bottom-0 inset-x-0 flex-wrap gap-x-5 gap-y-1 items-center px-5 py-4 text-xs u-mono" style="color: #a1a1aa; background: linear-gradient(to top, rgb(7 7 10 / .9), transparent)">
    <span class="flex gap-2 items-center"><span class="inline-block size-2 rounded-full" style="background: #fef3c7"></span>your text</span>
    <span class="flex gap-2 items-center"><span class="inline-block rounded-full" style="background: #f59e0b; width: .7rem; height: .45rem"></span>the answer</span>
    <span class="ml-auto">no cell, no Wi-Fi</span>
  </figcaption>
</figure>

<style>
  .globe { background: #07070a; }
  .globe-star { opacity: .7; }
  @media (prefers-reduced-motion: no-preference) {
    .globe-star { animation: globe-twinkle 5s ease-in-out infinite; }
    @keyframes globe-twinkle { 0%, 100% { opacity: .15; } 50% { opacity: .85; } }
    .globe-flow { animation: globe-flow 1.6s linear infinite; }
    @keyframes globe-flow { to { stroke-dashoffset: -24; } }
    .globe-ping { transform-box: fill-box; transform-origin: center; animation: globe-ping 2.6s cubic-bezier(.16, 1, .3, 1) infinite; }
    .globe-ping-late { animation-delay: 1.3s; }
    @keyframes globe-ping { from { transform: scale(1); opacity: .9; } to { transform: scale(5.5); opacity: 0; } }
    .globe-sat { animation: globe-bob 7s ease-in-out infinite alternate; }
    @keyframes globe-bob { from { transform: translateY(-2px); } to { transform: translateY(3px); } }
  }
  /* animateMotion cannot be paused from CSS, so it is not drawn at all. */
  @media (prefers-reduced-motion: reduce) {
    .globe-packets { display: none; }
  }
</style>
